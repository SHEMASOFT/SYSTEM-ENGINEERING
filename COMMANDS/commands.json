      "agent": "shema-ai-coordinador",
      "execution_intent": "CREATE",
      "risk_level": "low",
      "inputs": [
        "--dir",
        "--name",
        "--owner",
        "--domains",
        "--criticality",
        "--id",
        "--force"
      ],
      "outputs": [
        "PROJECT.json",
        "workspace directories",
        ".gitignore",
        "discovery.json"
      ],
      "gate": "G0",
      "primary_agent": "shema-ai-coordinador",
