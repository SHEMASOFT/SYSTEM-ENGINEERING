          "type": "string",
          "required": false,
          "description": "Project criticality (low|medium|high|critical|unknown)."
        },
        {
          "name": "--id",
          "type": "string",
          "required": false,
          "description": "Project id (PRJ-XXXX)."
        },
        {
          "name": "--force",
          "type": "boolean",
          "required": false,
          "description": "Repair or force re-run without overwriting seeded files."
