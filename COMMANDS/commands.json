{
  "schema_version": "1",
  "interface_version": "0.5.0",
  "description": "Conceptual command interface. Exposable via CLI, OpenCode, other agents or automation.",
  "conventions": {
    "project_flag": "--project <dir> points at a managed project workspace.",
    "exit_codes": {
      "0": "success",
      "1": "validation or gate failure",
      "2": "usage error"
    },
    "note": "Commands never bypass gates. Manual gate conditions are reported, never auto-passed."
