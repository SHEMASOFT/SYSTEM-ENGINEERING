{
  "model": "nvidia/nemotron-3-ultra-550b-a55b",
  "tools": [
    "skill:checkpoint-release",
    "skill:dbg-systematic",
    "skill:rev-adversarial",
    "skill:verification-review",
    "skill:visual-frontend-engineering",
    "skill:work-mode-selection",
    "read",
    "write",
    "edit",
    "bash",
    "grep",
    "find",
    "ls"
  ],
  "permissions": {
    "read": true,
    "write": true,
    "execute": true
  },
  "mcpServers": {
    "context7": {
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@4.4.0"
      ],
      "args": [],
      "env": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "filesystem": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "args": [],
      "env": {}
    },
    "se-memory-server": {
      "command": [
        "node",
        "SCRIPTS/se_core/mcp/launch.mjs",
        "SCRIPTS/se_core/mcp/memory_server.py"
      ],
      "args": [],
      "env": {}
    },
    "se-skill-server": {
      "command": [
        "node",
        "SCRIPTS/se_core/mcp/launch.mjs",
        "SCRIPTS/se_core/mcp/skill_server.py"
      ],
      "args": [],
      "env": {}
    }
  },
  "hooks": {},
  "env": {}
}
