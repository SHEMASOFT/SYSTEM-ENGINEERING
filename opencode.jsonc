{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "shema-ai-coordinador",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@4.4.0"
        ],
        "environment": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ],
        "environment": {},
        "cwd": "."
      },
      "se-skill-server": {
        "type": "local",
        "command": [
          "node",
          "SCRIPTS/se_core/mcp/launch.mjs",
          "SCRIPTS/se_core/mcp/skill_server.py"
        ],
        "environment": {},
        "cwd": "."
      },
      "se-memory-server": {
        "type": "local",
        "command": [
          "node",
          "SCRIPTS/se_core/mcp/launch.mjs",
          "SCRIPTS/se_core/mcp/memory_server.py"
        ],
        "environment": {},
        "cwd": "."
      }
    },
    "timeout": {
      "startup": 60000
    }
  }
}
