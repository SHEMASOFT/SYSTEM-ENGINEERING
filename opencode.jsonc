{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@4.4.0"
        ],
        "environment": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ],
        "environment": {},
        "cwd": "."
      },
      "se-skill-server": {
        "type": "local",
        "command": [
          "python3",
          "SCRIPTS/se_core/mcp/skill_server.py"
        ],
        "environment": {},
        "cwd": "."
      },
      "se-memory-server": {
        "type": "local",
        "command": [
          "python3",
          "SCRIPTS/se_core/mcp/memory_server.py"
        ],
        "environment": {},
        "cwd": "."
      }
    },
    "timeout": {
      "startup": 60000
    }
  }
  // The SE orchestrator "coordinator" is generated as mode: primary in
  // .opencode/agents/coordinator.md, so it appears in the agent selector.
  // To make new sessions start with it, add:
  //   "default_agent": "coordinator",
}
