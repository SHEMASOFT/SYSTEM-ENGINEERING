# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment and secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*
tokens*

# Node
node_modules/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local caches and temp
*.log
tmp/
.cache/
*.tmp

# Generated binaries and archives
*.zip
*.tar
*.tar.gz
*.7z
*.exe
*.dll
*.so
*.dylib

# Local project workspaces created by `se init` (keep master system repo clean)
.workspaces/

# Isolated project repos (never absorb project workspaces into the master system).
# The directory itself is part of the layout, so a .gitkeep keeps it on a fresh
# clone while every project workspace stays untracked.
PROJECTS/*
!PROJECTS/.gitkeep

# Generated OpenCode assets (regenerate via `se adapter opencode`)
.opencode/node_modules/

# Generated runtime adapters for other runtimes (regenerate via `se adapter ...`)
.claude/
.codex/

# Any environment file (belt-and-suspenders on top of .env / .env.*)
*.env

# Tool-generated skill registry cache (regenerated by the gentle-ai plugin)
.atl/

# CodeGraph local index (regenerated by `gentle-ai codegraph init`)
.codegraph/
.codegraph-wsl/

# SE lifecycle state (created by `se install`/`se sync`; never committed)
.se/

# Local operator scripts and ad-hoc fixes (machine-specific; never committed)
.local/

# Memory records written by skills (runtime provenance; never committed)
MEMORY/

# Internal working records (audits, reviews, evidence, checkpoints, initiatives):
# kept locally for provenance, never published
DOCS/internal/
