{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.system-engineering.local/run.schema.json",
  "title": "RUN",
  "description": "RUN — one complete episode of work capturing intent, execution, runtime/harness/model identity, changes, tests, evidence, artifacts, state, checkpoint and recovery in a portable, runtime-agnostic way.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "project_id", "state", "created_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "run_id": { "type": "string", "pattern": "^RUN-[0-9]{4,}$" },
    "project_id": { "type": "string" },
    "state": { "type": "string", "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED", "BLOCKED", "CANCELLED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "author": { "type": "string" },
    "intent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "objective": { "type": "string" },
        "scope": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "at": { "type": "string" },
          "by": { "type": "string" },
          "decision": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tasks": { "type": "array", "items": { "type": "string" } },
        "workflows": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "agents": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "adapter": { "type": "string" },
        "harness": { "type": "string" },
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "platform": { "type": "string" },
        "python": { "type": "string" },
        "environment": { "type": "string" },
        "source": { "type": "string", "enum": ["observed", "declared", "unknown"] },
        "captured_at": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mcps": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "commits": { "type": "array", "items": { "type": "string" } },
        "migrations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "reports": { "type": "array", "items": { "type": "string" } },
    "checkpoint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "at": { "type": "string" },
        "state": { "type": "string" },
        "completed": { "type": "array", "items": { "type": "string" } },
        "pending": { "type": "array", "items": { "type": "string" } },
        "blocked": { "type": "array", "items": { "type": "string" } },
        "next_step": { "type": "string" },
        "resume": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "cwd": { "type": "string" },
            "command": { "type": "string" },
            "env": { "type": "object" }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "handoff": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "metadata": { "type": "object" }
  }
}
