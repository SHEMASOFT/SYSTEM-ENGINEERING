{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.system-engineering.local/sdd.schema.json",
  "title": "SDD",
  "description": "Software Design Document (Specification Driven Development) — formal design specification driving implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sdd_id", "project_id", "title", "version", "status", "summary", "context", "scope", "architecture", "interfaces", "data_models", "requirements_coverage"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "sdd_id": { "type": "string", "pattern": "^SDD-\\d{4}$" },
    "project_id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{1,31}$" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "IMPLEMENTED", "SUPERSEDED", "ARCHIVED"] },
    "summary": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "components", "data_flow", "deployment"],
      "properties": {
        "overview": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "responsibility", "interfaces", "dependencies"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "responsibility": { "type": "string", "minLength": 1 },
              "interfaces": { "type": "array", "items": { "type": "string" } },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "data_flow": { "type": "string", "minLength": 1 },
        "deployment": { "type": "string", "minLength": 1 }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "protocol", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["sync", "async", "event"] },
          "protocol": { "enum": ["HTTP", "gRPC", "message", "other"] },
          "schema_ref": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "fields", "relationships"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["string", "integer", "boolean", "object", "array", "number"] },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "type", "description"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "type": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "requirements_coverage": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^REQ-\\d{4}$" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "likelihood", "impact", "mitigation"],
        "properties": {
          "risk": { "type": "string", "minLength": 1 },
          "likelihood": { "enum": ["low", "medium", "high"] },
          "impact": { "enum": ["low", "medium", "high"] },
          "mitigation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "related_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ADR-\\d{4}$" }
    },
    "related_tasks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TASK-\\d{4}$" }
    },
    "author": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
