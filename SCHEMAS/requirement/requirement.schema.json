{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.system-engineering.local/requirement.schema.json",
  "title": "REQUIREMENT",
  "description": "Requirement, assumption, constraint, risk, idea or unknown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "type", "title", "description", "priority", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^REQ-\\d{4}$" },
    "project_id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{1,31}$" },
    "type": { "enum": ["REQUIREMENT", "ASSUMPTION", "CONSTRAINT", "RISK", "IDEA", "UNKNOWN"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string" },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^REQ-\\d{4}$" }
    },
    "status": { "enum": ["PROPOSED", "APPROVED", "IMPLEMENTED", "VERIFIED", "REJECTED", "DEFERRED"] },
    "source": { "type": "string" },
    "owner": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "related_tasks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^TASK-\\d{4}$" } },
    "related_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^REQ-\\d{4}$" } },
    "related_decisions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^ADR-\\d{4}$" } },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "REQUIREMENT" } },
        "required": ["type"]
      },
      "then": {
        "required": ["acceptance_criteria"],
        "properties": { "acceptance_criteria": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["DEFERRED", "REJECTED"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["rationale"],
        "properties": { "rationale": { "minLength": 1 } }
      }
    }
  ]
}
