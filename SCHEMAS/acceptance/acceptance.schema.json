{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.system-engineering.local/acceptance.schema.json",
  "title": "ACCEPTANCE",
  "description": "An explicit acceptance decision (result), distinct from the acceptance criteria declared on a requirement or task. Requires human authority and evidence; never auto-approved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "acceptance_id", "project_id", "scope", "evidence", "result", "decided_by", "authority", "decided_at", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "acceptance_id": { "type": "string", "pattern": "^ACC-\\d{4}$" },
    "project_id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{1,31}$" },
    "scope": { "type": "string", "minLength": 1 },
    "criteria_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(REQ|TASK)-\\d{4}$" } },
    "related_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^REQ-\\d{4}$" } },
    "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-\\d{4}$" } },
    "result": { "enum": ["ACCEPTED", "REJECTED", "CONDITIONAL", "DEFERRED"] },
    "decided_by": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" },
    "gate": { "type": "string", "pattern": "^G[0-8]$" },
    "notes": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
