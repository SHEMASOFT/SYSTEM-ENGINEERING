{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.system-engineering.local/memory/query.schema.json",
  "title": "Memory Query",
  "description": "Query parameters for memory retrieval",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{1,31}$" },
    "types": { "type": "array", "items": { "enum": ["decision", "architecture", "discovery", "constraint", "capability", "verification", "checkpoint", "relationship"] } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "since": { "type": "string", "format": "date-time" },
    "until": { "type": "string", "format": "date-time" },
    "tags_mode": { "enum": ["any", "all"], "default": "any" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 50 },
    "offset": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
