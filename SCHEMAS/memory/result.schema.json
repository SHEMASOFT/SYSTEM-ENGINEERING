{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.system-engineering.local/memory/result.schema.json",
  "title": "Memory Query Result",
  "description": "Result of a memory query",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "project_id", "memories"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "query_id": { "type": "string", "pattern": "^MQR-\\d{4}$" },
    "project_id": { "type": "string", "pattern": "^PRJ-[A-Z0-9][A-Z0-9-]{1,31}$" },
    "queried_at": { "type": "string", "format": "date-time" },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memory_id", "type", "content", "created_at", "author"],
        "properties": {
          "memory_id": { "type": "string", "pattern": "^MEM-\\d{4}$" },
          "type": { "type": "string" },
          "content": { "type": "object" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "author": { "type": "string" },
          "source": { "type": "string" },
          "related_memories": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "by_type": { "type": "object" },
        "by_author": { "type": "object" }
      }
    }
  }
}
